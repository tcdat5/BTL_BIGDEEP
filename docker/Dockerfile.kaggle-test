# Mô phỏng Kaggle Notebook (Linux, Python 3.12, Java 17) để chạy thử pipeline QUICK cục bộ trên CPU.
FROM python:3.12-slim-bookworm
COPY --from=eclipse-temurin:17-jre /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="/opt/java/openjdk/bin:${PATH}"
# LightGBM cần OpenMP (Kaggle có sẵn, image slim thì không)
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu
COPY requirements-kaggle.txt /tmp/requirements-kaggle.txt
RUN pip install --no-cache-dir -r /tmp/requirements-kaggle.txt pyspark==3.5.1
WORKDIR /repo
